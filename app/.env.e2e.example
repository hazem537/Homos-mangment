# Copy to .env.e2e and fill in values (do not commit .env.e2e)
E2E_BASE_URL=http://localhost:3000
E2E_USERNAME=e2e
E2E_PASSWORD=change-me

# Optional but recommended for leftover cleanup after the suite
# (Supabase → Project Settings → API → service_role)
# E2E_SERVICE_ROLE_KEY=your-service-role-key
